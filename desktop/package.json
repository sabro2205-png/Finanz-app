{
  "name": "kassenbuch",
  "productName": "Kassenbuch",
  "version": "1.0.0",
  "description": "Übersicht über Einnahmen, Ausgaben und Erspartes",
  "main": "main.js",
  "author": "sabro2205",
  "license": "MIT",
  "private": true,
  "scripts": {
    "sync": "node sync.js",
    "prestart": "npm run sync",
    "start": "electron .",
    "predist": "npm run sync",
    "dist": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.sabro.kassenbuch",
    "productName": "Kassenbuch",
    "directories": { "buildResources": "build" },
    "files": ["main.js", "preload.js", "renderer/**"],
    "mac": {
      "category": "public.app-category.finance",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png"
    }
  }
}
